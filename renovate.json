{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "CI runs the SDK coverage test and the image smoke test, so a green SDK bump ships on its own.",
      "matchPackageNames": ["rapidata"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
